# Copia este archivo como .env.local y llena los valores.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave secreta (service_role). NUNCA la compartas ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wompi > Desarrolladores (usar llaves de pruebas "test" mientras tanto)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
